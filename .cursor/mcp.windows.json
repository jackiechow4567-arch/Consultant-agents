{
  "mcpServers": {
    "tradingview": {
      "command": "uvx",
      "args": [
        "--from",
        "tradingview-assistant",
        "--with",
        "mcp[cli]>=1.12.0,<2",
        "tradingview-mcp"
      ],
      "env": {
        "PATH": "${env:USERPROFILE}\\.local\\bin;${env:LOCALAPPDATA}\\Programs\\uv;${env:PATH}"
      }
    }
  }
}
